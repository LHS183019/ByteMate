{
  "manifest_version": 3,
  "name": "AI OpenJudge Helper",
  "description": "OpenJudge 学习助手：问题引导、思路提示、代码纠错、学习进度、宠物陪伴。",
  "version": "0.1",

  "action": {
    "default_popup": "popup/popup.html"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.openjudge.cn/*", "*://openjudge.cn/*"],
      "js": ["content/content-script.js"],
      "css": ["content/style.css"]
    },
    {
      "matches": ["*://bailian.openjudge.cn/practice/solution/*/"],
      "js": ["content/result-check.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "assets/*",
        "dashboard/*",
        "prompts/*",
        "problemset/*",
        "test/*",
        "debug/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
