{
  "manifest_version": 3,
  "name": "POJPaw - AI OpenJudge Helper",
  "description": "OpenJudge 学习助手：问题引导、思路提示、代码纠错、学习进度、宠物陪伴。",
  "version": "1.0.0",

  "icons": {
    "16": "assets/kitten/idle_facing_left/pixil-frame-4.png",
    "48": "assets/kitten/idle_facing_left/pixil-frame-4.png",
    "128": "assets/kitten/idle_facing_left/pixil-frame-4.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/kitten/idle_facing_left/pixil-frame-4.png",
      "48": "assets/kitten/idle_facing_left/pixil-frame-4.png",
      "128": "assets/kitten/idle_facing_left/pixil-frame-4.png"
    }
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboard-write"
  ],

  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://www.google-analytics.com/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.openjudge.cn/*", "*://openjudge.cn/*"],
      "js": ["content/content-script.js"],
      "css": ["content/style.css"]
    },
    {
      "matches": [
        "*://*.openjudge.cn/*/solution/*",
        "*://*.openjudge.cn/solution/*"
      ],
      "js": ["content/result-check.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "assets/*",
        "dashboard/*",
        "prompts/*",
        "problemset/*",
        "test/*",
        "debug/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
